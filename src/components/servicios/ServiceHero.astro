---
export interface Props {
  title: string;
  subtitle: string;
  icon: string;
}

const { title, subtitle, icon } = Astro.props;

const words = title.split(" ");
const accentIndex = words.length > 1 ? 1 : 0;
---

<section class="section-hero bg-gradient-blue relative overflow-hidden">
  <!-- Imagen izquierda - esquina inferior -->
  <img 
    src="/img/decora-izquierdo.png" 
    alt="" 
    loading="lazy"
    decoding="async"
    class="absolute left-[-50px] bottom-[-8%] h-[40%] max-w-[25%] w-auto object-cover object-left-bottom pointer-events-none select-none z-0 opacity-30 animate-slide-right hidden md:block"
    style="animation-delay: 200ms"
  />

  <!-- Imagen derecha - esquina superior -->
  <img 
    src="/img/decora-derecho.png" 
    alt="" 
    loading="lazy"
    decoding="async"
    class="absolute right-[-50px] top-[-8%] h-[40%] max-w-[25%] w-auto object-cover object-right-top pointer-events-none select-none z-0 opacity-30 animate-slide-left hidden md:block"
    style="animation-delay: 300ms"
  />

  <!-- Partículas flotantes -->
  <div class="particle particle-1"></div>
  <div class="particle particle-2"></div>
  <div class="particle particle-3"></div>

  <!-- Contenido principal -->
  <div class="max-w-4xl mx-auto w-full px-4 pt-16 md:pt-20 relative z-10 text-center">
    <!-- Icono 3D con glow -->
    <div class="icon-glow-container animate-slide-down mb-8" style="animation-delay: 0ms">
      <img src={icon} alt={title} class="h-28 md:h-36 lg:h-40 w-auto object-contain mx-auto icon-glow" />
    </div>
    
    <!-- Título -->
    <h1 class="text-xl sm:text-3xl md:text-5xl lg:text-7xl font-display font-semibold leading-[1.1] text-center">
      {words.map((word, i) => (
        <span
          class:list={[
            "block animate-slide-up",
            i === 0 ? "" : "pt-2"
          ]}
          style={`animation-delay: ${100 + i * 150}ms`}
        >
          <span class:list={["inline-block", { "text-primary-500": i === accentIndex }]}>
            {word}
          </span>
        </span>
      ))}
    </h1>
    
    <!-- Subtítulo -->
    <p
      class="text-lg mt-4 md:text-xl text-center text-neutral-300 max-w-3xl mx-auto block animate-fade-in"
      style="animation-delay: 500ms"
    >
      {subtitle}
    </p>
    
    <!-- Botón CTA -->
    <div class="mt-4 mb-10 flex flex-col md:flex-row gap-4 justify-center items-center animate-fade-in" style="animation-delay: 700ms">
      <a href="/#contacto" class="btn-primary">Solicitar este servicio</a>
    </div>
  </div>
</section>

<style is:global>
  /* Icono glow */
  .icon-glow-container {
    display: inline-block;
  }

  .icon-glow {
    filter: drop-shadow(0 0 20px rgba(249, 115, 22, 0.4));
    transition: filter 0.3s ease;
  }

  .icon-glow-container:hover .icon-glow {
    filter: drop-shadow(0 0 30px rgba(249, 115, 22, 0.6));
  }

  /* Partículas flotantes */
  .particle.particle {
    position: absolute;
    background: var(--color-primary-500);
    border-radius: 4px;
    opacity: 0.15;
    animation: float 6s ease-in-out infinite;
    z-index: 1;
  }

  .particle.particle-1 {
    width: 20px;
    height: 20px;
    top: 20%;
    left: 8%;
    animation-delay: 0s;
  }

  .particle.particle-2 {
    width: 15px;
    height: 15px;
    top: 65%;
    right: 12%;
    animation-delay: 2s;
  }

  .particle.particle-3 {
    width: 25px;
    height: 25px;
    bottom: 25%;
    left: 15%;
    animation-delay: 4s;
  }
</style>


