---
import SectionTitle from "./SectionTitle.astro";

export interface Props {
  steps: { title: string; description: string }[];
}

const { steps } = Astro.props;
---

<section class="py-16 md:py-24 px-4" style="background: linear-gradient(180deg, #101417 21%, #222B36 70%, #334155 100%)">
  <div class="max-w-5xl mx-auto">
    <SectionTitle title="Metodología de trabajo" />
    <p class="text-neutral-400 text-center mb-12 max-w-2xl mx-auto">Nuestro proceso paso a paso para entregar resultados excepcionales.</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((step, i) => (
        <div class="card-soft p-6 relative overflow-hidden group" data-scroll data-scroll-delay={i * 100}>
          <div class="absolute inset-0 opacity-20 pointer-events-none bg-gradient-gray"></div>
          <div class="relative z-10">
            <span class="block text-5xl md:text-6xl font-display font-bold text-right text-white/20 group-hover:text-primary-500 transition-colors duration-300">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="text-primary-300 font-bold text-lg -mt-2">{step.title}</h3>
            <p class="text-neutral-400 text-sm mt-1">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>