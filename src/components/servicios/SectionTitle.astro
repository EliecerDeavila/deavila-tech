---
interface Props {
  title: string;
  variant?: 'badge' | 'white';
}
const { title, variant = 'badge' } = Astro.props;
---

{variant === 'badge' ? (
  <h4 class="text-xl text-primary-300 font-bold mb-4 bg-dark-900 border border-primary-300 block w-72 py-2 rounded-2xl mx-auto text-center">
    {title}
  </h4>
) : (
  <h2 class="text-2xl md:text-3xl font-display font-bold text-white text-center mb-4">
    {title}
  </h2>
)}
