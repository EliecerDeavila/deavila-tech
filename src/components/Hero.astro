<section class="section-hero bg-gradient-blue">
    <div class="max-w-4xl mx-auto w-full px-4 pt-16 md:pt-20">
        <h1
            class="text-xl sm:text-3xl md:text-5xl lg:text-7xl font-display font-semibold leading-[1.1] text-center"
        >
            <span
                class="block relative w-fit mx-auto animate-slide-up"
                style="animation-delay: 0ms"
            >
                <span id="word-transformamos" class="inline-block"
                    >Transformamos</span
                > tu
                <span
                    id="line-1-bar"
                    class="absolute -bottom-2 md:-bottom-3 h-2.5 md:h-5 bg-primary-400 rounded-sm"
                ></span>
            </span>

            <span
                class="block pt-2 animate-slide-up"
                style="animation-delay: 150ms"
            >
                <span class="text-primary-500">negocio</span> con
            </span>

            <span class="block animate-slide-up" style="animation-delay: 300ms"
                >soluciones</span
            >

            <span
                class="block relative w-fit mx-auto animate-slide-up"
                style="animation-delay: 450ms"
            >
                digitales a <span id="word-medida" class="inline-block"
                    >medida</span
                >
                <span
                    id="line-2-bar"
                    class="absolute -bottom-2 md:-bottom-3 h-2.5 md:h-5 bg-primary-400 rounded-sm"
                ></span>
            </span>
        </h1>
        <p
            class="text-lg mt-4 md:text-xl text-center text-neutral-300 max-w-3xl mx-auto block animate-fade-in"
            style="animation-delay: 700ms"
        >
            Diseñamos y desarrollamos plataformas digitales que optimizan
            procesos, mejoran tu presencia online y potencian el crecimiento de
            tu empresa.
        </p>
        <div class="mt-4 mb-10 flex flex-col md:flex-row gap-4 justify-center items-center animate-fade-in"
            style="animation-delay: 900ms"
        >
            <a href="#contacto" class="btn-primary">Contáctanos</a>
            <a href="#servicios" class="btn-secondary">Nuestros servicios</a>
        </div>
    </div>
</section>

<script>
    function updateBars() {
        const w1 = document.getElementById("word-transformamos");
        const b1 = document.getElementById("line-1-bar");
        if (w1 && b1) {
            const r = w1.getBoundingClientRect();
            b1.style.left = -r.left + "px";
            b1.style.width = r.right + "px";
        }
        const w2 = document.getElementById("word-medida");
        const b2 = document.getElementById("line-2-bar");
        if (w2 && b2) {
            const r = w2.getBoundingClientRect();
            const p = w2.parentElement.getBoundingClientRect();
            b2.style.left = r.left - p.left + "px";
            b2.style.width = window.innerWidth - r.left + "px";
        }
    }
    document.addEventListener("DOMContentLoaded", () => {
        updateBars();
        document.fonts.ready.then(updateBars);
        window.addEventListener("resize", updateBars);
    });
</script>
