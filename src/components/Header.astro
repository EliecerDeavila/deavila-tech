<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-primary-500 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:font-semibold">
  Saltar al contenido
</a>

<header id="site-header" class="text-neutral-50 h-16 md:h-20 fixed top-0 left-0 w-full z-50">
  <div class="container-page flex items-center justify-between h-full">
    <a href="/" class="flex items-center space-x-2">
      <img src="/logo.svg" alt="Logo" class="h-8 w-auto" />
    </a>

    <button id="menu-toggle" class="block md:hidden text-neutral-50" aria-label="Menú">
      <svg id="icon-menu" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <line x1="4" x2="20" y1="12" y2="12"/>
        <line x1="4" x2="20" y1="6" y2="6"/>
        <line x1="4" x2="20" y1="18" y2="18"/>
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <path d="M18 6 6 18"/>
        <path d="m6 6 12 12"/>
      </svg>
    </button>

    <nav id="nav-menu" class="hidden md:flex absolute md:static top-full left-0 w-full md:w-auto bg-dark-950 md:bg-transparent z-50">
      <ul class="flex flex-col md:flex-row items-center space-y-2 md:space-y-0 md:space-x-4 py-4 md:py-0">
        <li><a href="/#servicios" class="block py-2 px-4 hover:text-primary-400 transition focus-visible:outline-2 focus-visible:outline-primary-500 focus-visible:outline-offset-2 rounded">Servicios</a></li>
        <li><a href="/#beneficios" class="block py-2 px-4 hover:text-primary-400 transition focus-visible:outline-2 focus-visible:outline-primary-500 focus-visible:outline-offset-2 rounded">Beneficios</a></li>
        <li><a href="/#procesos" class="block py-2 px-4 hover:text-primary-400 transition focus-visible:outline-2 focus-visible:outline-primary-500 focus-visible:outline-offset-2 rounded">Procesos</a></li>
        <li><a href="/#contacto" class="btn-primary py-2 px-4 text-center text-white">Contacto</a></li>
      </ul>
    </nav>
  </div>

  <div id="menu-overlay" class="hidden fixed inset-0 bg-black/50 z-40"></div>
</header>

<style>
  #site-header {
    background-color: rgb(2 6 23);
    transition: background-color 0.3s, backdrop-filter 0.3s, box-shadow 0.3s;
  }
  #site-header.scrolled {
    background-color: rgb(2 6 23 / 0.8);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 4px 24px rgb(0 0 0 / 0.15);
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("nav-menu");
    const overlay = document.getElementById("menu-overlay");
    const iconMenu = document.getElementById("icon-menu");
    const iconClose = document.getElementById("icon-close");

    function closeMenu() {
      menu?.classList.add("hidden");
      overlay?.classList.add("hidden");
      iconMenu?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    }

    function openMenu() {
      menu?.classList.remove("hidden");
      overlay?.classList.remove("hidden");
      iconMenu?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
    }

    if (toggle && menu && overlay) {
      toggle.addEventListener("click", () => {
        if (menu.classList.contains("hidden")) {
          openMenu();
        } else {
          closeMenu();
        }
      });

      overlay.addEventListener("click", closeMenu);

      document.querySelectorAll("#nav-menu a").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });
    }

    // Header translúcido + active link según scroll
    const header = document.getElementById("site-header");
    const navLinks = document.querySelectorAll("#nav-menu a:not(.btn-primary)");
    const secciones = [
      { el: document.querySelector(".section-hero"), id: "hero" },
      { el: document.getElementById("servicios"), id: "servicios" },
      { el: document.getElementById("beneficios"), id: "beneficios" },
      { el: document.getElementById("procesos"), id: "procesos" },
      { el: document.getElementById("contacto"), id: "contacto" },
    ];

    function getVisibleRatio(el) {
      const r = el.getBoundingClientRect();
      const viewH = window.innerHeight;
      const visibleTop = Math.max(0, r.top);
      const visibleBottom = Math.min(viewH, r.bottom);
      const visibleH = Math.max(0, visibleBottom - visibleTop);
      return el.offsetHeight > 0 ? visibleH / el.offsetHeight : 0;
    }

    let ticking = false;
    window.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          if (window.scrollY > 80) {
            header.classList.add("scrolled");
          } else {
            header.classList.remove("scrolled");
          }

          let bestId = null;
          let bestRatio = 0;
          secciones.forEach((s) => {
            if (!s.el) return;
            const ratio = getVisibleRatio(s.el);
            if (ratio > bestRatio) {
              bestRatio = ratio;
              bestId = s.id;
            }
          });

          navLinks.forEach((l) => l.classList.remove("text-primary-500"));
          if (bestId && bestId !== "hero") {
            const active = document.querySelector(`#nav-menu a[href="/#${bestId}"]`);
            active?.classList.add("text-primary-500");
          }

          ticking = false;
        });
        ticking = true;
      }
    });
  });
</script>